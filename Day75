public class Day75 {
    public static void main(String[] args) {
        // Day75
        // Method String untuk Pengecekan

        // 1. equals()
        String nama = "Alamsyah";

        if (nama.equals("Alamsyah")) {
            System.out.println("Nama sama");
        } else {
            System.out.println("Nama berbeda");
        }

        // 2. equalsIgnoreCase()
        String username = "Day75";

        if (username.equalsIgnoreCase("DAY75")) {
            System.out.println("Username cocok");
        } else {
            System.out.println("Username tidak cocok");
        }

        // 3. contains()
        String kalimat = "Saya sedang belajar Java";

        if (kalimat.contains("Java")) {
            System.out.println("Kata Java ditemukan");
        } else {
            System.out.println("Kata Java tidak ditemukan");
        }

        // 4. isEmpty()
        String teks = "";

        if (teks.isEmpty()) {
            System.out.println("Teks masih kosong");
        } else {
            System.out.println("Teks sudah terisi");
        }
    }
}
