import java.util.Scanner;

public class Day52 {
    public static void main(String[] args) {

        // Day52
        // Perulangan while

        Scanner in = new Scanner(System.in);

        System.out.print("Masukkan angka: ");
        int a = in.nextInt();

        int i = 1;

        while (i <= a) {
            System.out.println(i);
            i++;
        }

        in.close();
    }
}
